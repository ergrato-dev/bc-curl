# Caddyfile del laboratorio bc-curl
#
# Caddy hace de frontal TLS delante de go-httpbin. Con un solo contenedor el
# alumno tiene HTTPS, HTTP/2, HTTP/3 y una CA propia con la que practicar
# --cacert, en vez de aprender a desactivar la verificacion con -k.

{
	# El laboratorio es local: sin ACME, sin redirecciones automaticas.
	auto_https disable_redirects
	admin off

	servers {
		# h3 necesita ademas el puerto UDP publicado en el compose.
		protocols h1 h2 h3
	}
}

# --- Endpoint TLS normal ---------------------------------------------------
# Certificado emitido por la CA interna de Caddy. Sin --cacert, curl falla con
# el codigo 60 y ese fallo es el punto pedagogico de la Semana 05.
# Se declaran los dos nombres para que el mismo certificado valga desde el
# host (localhost) y desde otro contenedor de la red del laboratorio (tls).
https://localhost:{$TLS_PORT:8443}, https://tls:{$TLS_PORT:8443} {
	tls internal

	header X-Lab-Endpoint "tls"

	# --- API paginada (Semana 07) ---------------------------------------------
	# /paginas devuelve un listado JSON en tres paginas, con el header Link de
	# RFC 8288 que usa GitHub: rel="next" mientras quedan paginas, y ademas
	# prev, first y last. ?page=fuera devuelve un Link que salta a otro host:
	# un script que lo siga le manda la credencial a quien no debe.
	map {query.page} {lab_items} {lab_link} {
		""      `[\{"id":1\},\{"id":2\},\{"id":3\}]` `<https://{http.request.hostport}/paginas?page=2>; rel="next", <https://{http.request.hostport}/paginas?page=3>; rel="last"`
		1       `[\{"id":1\},\{"id":2\},\{"id":3\}]` `<https://{http.request.hostport}/paginas?page=2>; rel="next", <https://{http.request.hostport}/paginas?page=3>; rel="last"`
		2       `[\{"id":4\},\{"id":5\},\{"id":6\}]` `<https://{http.request.hostport}/paginas?page=1>; rel="prev", <https://{http.request.hostport}/paginas?page=3>; rel="next", <https://{http.request.hostport}/paginas?page=1>; rel="first", <https://{http.request.hostport}/paginas?page=3>; rel="last"`
		3       `[\{"id":7\}]` `<https://{http.request.hostport}/paginas?page=2>; rel="prev", <https://{http.request.hostport}/paginas?page=1>; rel="first"`
		fuera   `[\{"id":1\}]` `<https://otra-api.invalid/paginas?page=2>; rel="next"`
		bucle   `[\{"id":1\}]` `<https://{http.request.hostport}/paginas?page=bucle>; rel="next"`
		default `[]` ""
	}

	handle /paginas {
		@con_link expression `{lab_link} != ""`
		header @con_link Link {lab_link}
		header Content-Type application/json
		respond {lab_items} 200
	}

	# --- Rate limit (Semana 07) -----------------------------------------------
	# /limitado responde siempre 429 con Retry-After: 1, como una API que te
	# ha cortado el grifo. curl --retry espera lo que dice el header.
	handle /limitado {
		header Retry-After 1
		header Content-Type application/json
		respond `{"error":"demasiadas peticiones"}` 429
	}

	handle {
		reverse_proxy httpbin:8080
	}
}

# --- Endpoint mTLS ---------------------------------------------------------
# Exige que el cliente presente un certificado. Sirve para practicar
# --cert / --key sin montar una PKI completa.
https://localhost:{$MTLS_PORT:8444}, https://tls:{$MTLS_PORT:8444} {
	tls internal {
		client_auth {
			mode require
		}
	}

	header X-Lab-Endpoint "mtls"
	respond "mTLS OK: has presentado un certificado de cliente" 200
}
