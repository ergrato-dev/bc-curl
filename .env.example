# ============================================
# LABORATORIO bc-curl
# ============================================
# Copia este archivo a .env y ajusta lo que necesites:
#   cp .env.example .env
#
# NUNCA comitees el .env. Ya esta en .gitignore.

# --- Versiones de las imagenes -------------------------------------------
# Regla del bootcamp: nunca `latest`. Version completa siempre, para que un
# `docker compose pull` no cambie el laboratorio sin que nadie lo decida.
# Antes de subir cualquiera de estas: comprueba que el tag existe y sus CVEs.
HTTPBIN_VERSION=2.25.0
CADDY_VERSION=2.11.4-alpine
OAUTH_VERSION=6.0.2

# --- Puertos --------------------------------------------------------------
# Si alguno esta ocupado en tu maquina, cambialo aqui. El material usa estos
# valores por defecto en todos los ejemplos.
HTTPBIN_PORT=8080
OAUTH_PORT=8081
TLS_PORT=8443
MTLS_PORT=8444

# --- Comportamiento de go-httpbin ----------------------------------------
# Tiempo maximo que aceptan los endpoints /delay y /drip. Sube este valor si
# quieres experimentar con timeouts mas largos en la Semana 05.
HTTPBIN_MAX_DURATION=10s
